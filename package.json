{
    "name": "margin-matters",
    "version": "1.0.0",
    "description": "Tools and site sources for margin-matters",
    "private": true,
    "scripts": {
        "start": "npx http-server docs -c-1 -p 8080",
        "serve": "npx http-server -c-1 -p 8080",
        "lint": "npx eslint \"docs/**/*.js\" \"site_builder/**/*.js\" --color",
        "lint:fix": "npx eslint \"docs/**/*.js\" \"site_builder/**/*.js\" --color --fix",
        "lint:docs": "npx eslint \"docs/**/*.js\" --color",
        "validate:confidence": "node docs/utils/electionNight/validateConfidence.mjs",
        "validate:winprob": "node docs/utils/electionNight/validateWinProb.mjs"
    },
    "devDependencies": {
        "@eslint/css": "^0.13.0",
        "@eslint/js": "^8.57.1",
        "@eslint/json": "^0.13.2",
        "@eslint/markdown": "^7.4.0",
        "@typescript-eslint/eslint-plugin": "^8.46.0",
        "@typescript-eslint/parser": "^8.46.0",
        "eslint": "^8.57.1",
        "globals": "^16.4.0",
        "http-server": "^14.1.1",
        "playwright": "^1.62.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.0"
    },
    "eslintConfig": {
        "env": {
            "browser": true,
            "es2021": true
        },
        "extends": "eslint:recommended",
        "parserOptions": {
            "ecmaVersion": "latest",
            "sourceType": "module"
        },
        "rules": {
            "no-unused-vars": [
                "warn"
            ],
            "no-console": "off"
        }
    }
}
