{
  "name": "margin-matters",
  "version": "1.0.0",
  "description": "Tools and site sources for margin-matters",
  "private": true,
  "scripts": {
    "start": "npx http-server docs -c-1 -p 8080",
    "serve": "npx http-server -c-1 -p 8080",
    "lint": "npx eslint 'docs/**/*.js' 'site_builder/**/*.js' --ext .js",
    "lint:fix": "npx eslint 'docs/**/*.js' 'site_builder/**/*.js' --ext .js --fix"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "http-server": "^14.1.1"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": ["warn"],
      "no-console": "off"
    }
  }
}
